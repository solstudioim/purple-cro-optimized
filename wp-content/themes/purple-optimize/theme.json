{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1200px"
		},
		"border": {
			"radius": true
		},
		"typography": {
			"fontFamilies": [
				{
					"fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
					"name": "System",
					"slug": "system"
				}
			]
		}
	},
	"styles": {
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--system)"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontWeight": "650",
					"lineHeight": "1.08"
				}
			},
			"link": {
				"color": {
					"text": "#3b0764"
				}
			}
		},
		"blocks": {
			"core/button": {
				"border": {
					"radius": "4px"
				},
				"typography": {
					"fontWeight": "650"
				}
			},
			"woocommerce/product-button": {
				"spacing": {
					"margin": {
						"top": "var:preset|spacing|20"
					}
				}
			}
		}
	}
}
